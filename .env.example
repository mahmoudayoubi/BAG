# Copy this file to .env for local runs, or set these as environment
# variables in your hosting provider's dashboard (Render, Railway, etc).

# Required — the password for the admin dashboard at /admin.
ADMIN_PASSWORD=change-me-to-something-strong

# Optional — defaults to "admin" if not set.
ADMIN_USERNAME=admin

# Optional but recommended in production — a random secret used to sign
# session cookies. If not set, one is generated at startup, which means
# admins get logged out every time the server restarts. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional — the port the server listens on (most hosts set this for you).
PORT=3000
